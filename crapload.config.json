{
  "include": [
    "apps/**/*.{ts,tsx,mts,cts}",
    "packages/**/*.{ts,tsx,mts,cts}",
    "infra/**/*.{ts,tsx,mts,cts}"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.expo/**",
    "**/.turbo/**",
    "**/generated/**",
    "**/e2e/**",
    "**/scripts/**",
    "**/test/**",
    "**/tests/**",
    "**/testing/**",
    "**/fixtures/**",
    "**/__tests__/**",
    "**/__fixtures__/**",
    "**/__mocks__/**",
    "**/*.{test,spec,integration,contention,testkit,pw,test-utils}.{ts,tsx,mts,cts}",
    "**/*-{fixture,fixtures,mock,mocks}.{ts,tsx,mts,cts}",
    "**/test-{probe,probes,shim,*-shim}.{ts,tsx,mts,cts}",
    "**/{fake,fakes,testing}.{ts,tsx,mts,cts}",
    "apps/mobile/src/features/expenses/expenses-probe.tsx",
    "apps/mobile/src/updates/expo-updates-stand-in.ts",
    "packages/adapters/src/blob/memory.ts",
    "packages/adapters/src/fx/FixtureRates.ts",
    "packages/core/src/store/memory.ts",
    "**/*.d.ts"
  ],
  "presets": ["effect", "drizzle"],
  "thresholds": {
    "maxScore": 30,
    "maxComplexity": 15
  },
  "baseline": {
    "file": "crapload-baseline.json",
    "tolerance": 0.5
  }
}
