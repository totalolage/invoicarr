{
  "name": "kvitbit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra/*"
  ],
  "scripts": {
    "lint": "turbo run lint //#lint:root",
    "lint:root": "biome check --error-on-warnings biome.jsonc crapload.config.json knip.jsonc package.json tsconfig.base.json tsconfig.effect.json turbo.json formal scripts lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck //#typecheck:formal //#typecheck:scripts",
    "typecheck:formal": "effect-tsgo tsc -p formal/tsconfig.json",
    "verify:formal": "bun formal/run-formal.ts",
    "verify:formal:cached": "turbo run //#formal:all",
    "verify:formal:wide:cached": "turbo run //#formal:wide",
    "formal:selftest": "bun formal/run-formal.ts --selftest",
    "formal:digests": "bun formal/run-formal.ts --check-digests",
    "formal:tlc:counter": "bun formal/run-formal.ts --only selftest.counter",
    "formal:tlc:lifecycle": "bun formal/run-formal.ts --only lifecycle.model",
    "formal:tlc:outbox": "bun formal/run-formal.ts --only outbox.recurring",
    "formal:tlc:numbering": "bun formal/run-formal.ts --only numbering.allocator",
    "formal:tlc:idempotency": "bun formal/run-formal.ts --only idempotency.request-log-cas",
    "formal:replay:imports": "bun formal/run-formal.ts --only selftest.imports",
    "formal:replay:lifecycle": "bun formal/run-formal.ts --only lifecycle.replay",
    "formal:replay:outbox": "bun formal/run-formal.ts --only outbox.replay",
    "formal:replay:numbering": "bun formal/run-formal.ts --only numbering.replay",
    "formal:replay:idempotency": "bun formal/run-formal.ts --only idempotency.request-log-cas-replay",
    "formal:all": ":",
    "formal:wide:lifecycle": "bun formal/run-formal.ts --wide --only lifecycle.model",
    "formal:wide:outbox": "bun formal/run-formal.ts --wide --only outbox.recurring",
    "formal:wide:numbering": "bun formal/run-formal.ts --wide --only numbering.allocator",
    "formal:wide:idempotency": "bun formal/run-formal.ts --wide --only idempotency.request-log-cas",
    "formal:wide": ":",
    "test": "bun run test:lint-rules && turbo run test:suite //#test:issue-pool //#test:cache-graph //#test:alert-inbox //#test:static-checks",
    "coverage": "bun scripts/coverage.ts",
    "test:issue-pool": "bun test scripts/issue-pool",
    "test:cache-graph": "bun test scripts/turbo-cache-guard",
    "test:alert-inbox": "bun test scripts/alert-inbox",
    "test:static-mounts": "bun test ./apps/server/test/integration/static-mounts.integration.ts",
    "build": "turbo run build",
    "generate:bun-nix": "bun scripts/generate-bun-nix.ts",
    "check:bun-nix": "bun scripts/generate-bun-nix.ts --check",
    "db:generate": "turbo run db:generate --filter=@kvitbit/db",
    "test:lint-rules": "bun test ./lint",
    "typecheck:scripts": "effect-tsgo tsc -p scripts/tsconfig.json",
    "check:changed": "bun scripts/check-changed.ts",
    "knip:check:files": "bun --bun knip --files --dependencies",
    "knip:check:exports": "bun --bun knip --exports",
    "knip:check": "bun run --parallel --no-exit-on-error knip:check:files knip:check:exports",
    "crapload": "bun node_modules/crapload/src/cli.ts --no-coverage --baseline crapload-baseline.json",
    "crapload:changed": "bun node_modules/crapload/src/cli.ts --no-coverage --baseline crapload-baseline.json --changed",
    "crapload:baseline": "bun node_modules/crapload/src/cli.ts baseline --no-coverage",
    "crapload:crap": "bun node_modules/crapload/src/cli.ts --coverage coverage/lcov.info",
    "prepare": "if [ -f .githooks/install.sh ]; then sh .githooks/install.sh; fi",
    "test:static-checks": "bun test scripts/check-changed.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@effect/language-service": "0.87.5",
    "@effect/platform-bun": "4.1.4",
    "@effect/tsgo": "0.73.7",
    "@types/bun": "1.4.5",
    "crapload": "github:totalolage/crapload",
    "effect": "4.1.4",
    "knip": "6.48.0",
    "turbo": "2.11.13",
    "typescript": "6.0.2"
  },
  "overrides": {
    "effect": "4.1.4"
  },
  "packageManager": "bun@1.4.2"
}
